# RoadFix browser and API configuration template. Vite reads root .env files
# for frontend VITE_ values. The Node server reads its settings from the process
# environment and does not load .env itself; set server values in the Windows
# service/launcher environment. Copy only settings needed for the deployment.
# Never put secrets in VITE_ variables: they are included in client-side code.

# Browser API base URL. Empty uses same-origin requests (the local Vite proxy
# forwards /api to 127.0.0.1:4000). In production use the approved HTTPS API URL
# if the browser and API have different origins.
VITE_API_URL=

# API server configuration. The root development launcher defaults to local
# mode and loopback host. Production must use ROADFIX_SECURITY_MODE=production,
# an explicitly reviewed HOST/bind and PORT, and exact HTTPS origins below.
ROADFIX_SECURITY_MODE=local
NODE_ENV=development
HOST=127.0.0.1
PORT=4000

# Comma-separated exact browser origins, without paths or trailing route data.
# Leave blank for local mode's built-in localhost origins. Production requires
# at least one exact HTTPS origin, for example https://roadfix.example.invalid.
CORS_ORIGINS=

# Optional maximum total upload storage, in bytes. Default is 524288000 (500 MiB).
UPLOAD_STORAGE_MAX_BYTES=

# Legacy/inactive for current RoadFix application data and authentication.
# These variables are still read by the retained Supabase helper/package, but
# the active application uses the local RoadFix API and SQLite instead.
# Leave blank. Never use a service-role key or secret in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
